# Copy this file to .env and fill in the values:
#   cp env.template .env

# Required — local Xians server
XIANS_SERVER_URL=http://localhost:5001

# Required — Base64-encoded X.509 certificate from Agent Studio → Developer / API keys.
# Must contain O= (tenant id) and CN= (user id). Starts like MIIE…
# A random string such as my-api-key-123 will fail auth.
XIANS_API_KEY=

# Required for chat replies. If unset, chat tells you to add the key; check-ins still send.
ANTHROPIC_API_KEY=

# Optional — default claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — proactive check-in interval. Default 10.
PROACTIVE_CHECKIN_EVERY_MINUTES=10
